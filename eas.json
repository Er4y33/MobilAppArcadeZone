{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "applicationIdSuffix": ".preview"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": { "production": {} }
}
